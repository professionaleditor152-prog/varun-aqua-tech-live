rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security and authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidProduct() {
      let data = request.resource.data;
      return data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.salePrice is number
          && data.salePrice >= 0
          && data.originalPrice is number
          && data.originalPrice >= 0
          && data.active is bool;
    }

    // ============================================================
    // VARUN AQUA TECH - Products Collection
    // ============================================================
    // - Public visitors can read products to view catalog and prices
    // - Only authenticated admin accounts can create, update, or delete
    // - Validates data types: non-empty name, positive prices, boolean active
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidProduct();
      allow delete: if isAuthenticated();
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: false;
    }
  }
}
